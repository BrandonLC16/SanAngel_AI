# Explicit build-context allowlist. Never send local branch data or credentials to a builder.
*
!requirements-prod.lock
!alembic.ini
!backend/
!backend/__init__.py
!backend/app/
!backend/app/**
!scripts/
!scripts/__init__.py
!scripts/run_backend.py
!scripts/container_healthcheck.py
!scripts/backup_sqlite.py
!scripts/restore_sqlite.py
!scripts/sqlite_validation.py
!migrations/
!migrations/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
!deploy/
!deploy/Caddyfile
!deploy/Caddyfile.container

# Defense in depth inside included directories.
.env
.env.*
**/.env
**/.env.*
secrets/
**/secrets/
**/secrets/**
*.assistant-profile.json
**/*.assistant-profile.json
**/*.assistant-faq.tsv
**/*.assistant-prices.xlsx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/__pycache__/**
**/*.pyc
**/node_modules/**
**/dist/**
