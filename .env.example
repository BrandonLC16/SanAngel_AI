APP_ENV=development
APP_NAME=Carniceria AI Chatbot
APP_HOST=127.0.0.1
APP_PORT=8000
# Exact IPs of proxies directly connected to this process. Empty by default.
TRUSTED_PROXY_IPS=
ADMIN_REQUESTS_PER_MINUTE=120
INTERNAL_REQUESTS_PER_MINUTE=30
WEBHOOK_REQUESTS_PER_SECOND=100
HTTP_BODY_READ_TIMEOUT_SECONDS=10
# Production: absolute path to a manager-mounted directory outside this repository.
SECRETS_DIR=

# Development only; production reads the matching file under SECRETS_DIR.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_STORE_RESPONSES=false
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# One immutable branch code per assistant installation and WhatsApp number.
ASSISTANT_BRANCH_CODE=
# Independent 32-256 character URL-safe secret; keep stable to retain conversation mapping.
CONVERSATION_IDENTITY_KEY=
# Independent backend-only 32-256 character URL-safe secret for admin CSRF/throttling.
ADMIN_AUTH_KEY=

DATABASE_URL=sqlite+pysqlite:///./carniceria.db

GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_API_URL=https://api.green-api.com
# Use 32-256 random URL-safe characters; keep this value empty in version control.
GREEN_API_WEBHOOK_TOKEN=
WHATSAPP_REQUEST_TIMEOUT_SECONDS=15

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CHAT_MAX_MESSAGE_CHARS=2000
LOG_LEVEL=INFO
